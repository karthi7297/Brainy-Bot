# ==========================================
# Brainy Bot Backend - Environment
# ==========================================

# --- Server ---
NODE_ENV=development
PORT=4000
# Comma separated list of allowed browser origins (frontend dev server)
CORS_ORIGIN=http://localhost:5173

# --- MySQL Database ---
DB_HOST=localhost
DB_PORT=3306
# >>> PASTE YOUR DATABASE USERNAME HERE <<<
DB_USER=root
# >>> PASTE YOUR DATABASE PASSWORD HERE <<<
DB_PASSWORD=
DB_NAME=brainybot

# --- Auth ---
# Change this to a long random string in production
JWT_SECRET=super-secret-brainy-bot-change-me
JWT_EXPIRES_IN=7d
